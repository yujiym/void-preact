{
  "name": "void-preact",
  "version": "0.1.1",
  "description": "Preact pages, server rendering, forms, and navigation for Void.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yujiym/void-preact.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./pages-client": {
      "types": "./dist/runtime/pages-client.d.mts",
      "import": "./dist/runtime/pages-client.mjs"
    },
    "./pages-server": {
      "types": "./dist/runtime/pages-server.d.mts",
      "import": "./dist/runtime/pages-server.mjs"
    },
    "./islands-client": {
      "types": "./dist/runtime/islands-client.d.mts",
      "import": "./dist/runtime/islands-client.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../tools/ci/prepare-package.ts"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.6",
    "pathslash": "^0.1.0"
  },
  "peerDependencies": {
    "preact": "11.1.1",
    "preact-render-to-string": "6.8.2",
    "vite": "^8.0.0",
    "void": "1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "preact": "11.1.1",
    "preact-render-to-string": "6.8.2",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.5.0",
    "vite-plus": "^1.5.0",
    "void": "1.6.1",
    "react": "workspace:*",
    "react-dom": "workspace:*"
  },
  "packageManager": "pnpm@12.16.1"
}
