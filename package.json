{
  "name": "void-preact-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "port": "node tools/port/run.mjs",
    "check:port": "node tools/port/run.mjs check",
    "build": "pnpm --filter void-preact build",
    "typecheck": "pnpm --filter void-preact typecheck",
    "test": "vp test run --project unit",
    "test:integration": "vp test run --project integration"
  },
  "devDependencies": {
    "cross-spawn": "^7.0.6",
    "playwright": "^1.64.1",
    "pathe": "^2.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.5.0",
    "vite-plus": "^1.5.0",
    "react": "workspace:*",
    "react-dom": "workspace:*"
  },
  "packageManager": "pnpm@12.16.1"
}
