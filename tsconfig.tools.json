{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "e2e/**/*.ts",
    "tools/comparison/*.ts",
    "tools/ci/*.ts",
    "tools/port/*.ts"
  ]
}
