{
  "name": "void-preact-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "port": "node tools/port/run.ts",
    "check:port": "node tools/port/run.ts check",
    "build": "pnpm --filter void-preact build",
    "typecheck": "pnpm --filter void-preact typecheck && pnpm typecheck:tools",
    "test": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "test:comparison": "pnpm typecheck:tools && node test/comparison/run.ts",
    "test:comparison:unit": "node --test test/comparison/*.test.ts",
    "check:suspense": "node tools/ci/check-suspense-support.ts",
    "typecheck:tools": "tsc --noEmit --project tsconfig.tools.json",
    "test:release": "node --test tools/ci/*.test.ts"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "cross-spawn": "^7.0.6",
    "pathe": "^2.0.3",
    "playwright": "^1.64.1",
    "react": "workspace:*",
    "react-dom": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.5.0",
    "vite-plus": "^1.5.0"
  },
  "packageManager": "pnpm@12.16.1"
}
